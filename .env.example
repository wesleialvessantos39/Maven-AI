# Somente local. Nunca colocar essas chaves em VITE_* nem enviar arquivo .env para o GitHub.
PORT=8787
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL_ECO=qwen2.5-coder:1.5b
OLLAMA_MODEL_BALANCED=qwen2.5-coder:3b
# Opcional: recomenda-se pelo menos 16 GB de RAM para o perfil avançado.
OLLAMA_MODEL_ADVANCED=qwen2.5-coder:7b
PROJECTS_ROOT=
# Configure apenas tokens com permissões mínimas. Para leitura: listar projetos basta.
GITHUB_TOKEN=
SUPABASE_ACCESS_TOKEN=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
# Desligado por padrão. Ligar manualmente após compreender os riscos.
ALLOW_REMOTE_MUTATIONS=false
ENABLE_SUPABASE_WRITES=false

# Opcional (serviço externo com cobrança, não incluído no ChatGPT Plus).
# Configure explicitamente os DOIS campos para liberar o perfil Nuvem.
OPENAI_API_KEY=
OPENAI_MODEL=
# Se true, só atualiza uma fonte oficial por dia enquanto a IA estiver aberta.
AUTO_REFRESH_DOCS=false

# Context7: documentação externa; chave exclusivamente no servidor.
# Gere sua chave em https://context7.com/dashboard
CONTEXT7_API_KEY=
# Opt-out de telemetria nos clientes oficiais.
CTX7_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1
SUPERPOWERS_DISABLE_TELEMETRY=1
